{
  "name": "@wien/backstage-i18n-de-plugin",
  "version": "1.0.0",
  "description": "German translations and TechDocs empty-state i18n for Backstage.",
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "i18n-de",
    "pluginPackages": [
      "@wien/backstage-i18n-de-plugin"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "i18n",
    "german",
    "stadt-wien",
    "wien"
  ],
  "homepage": "https://github.com/adis-b/hackstage/tree/main/my-backstage-app/plugins/backstage-i18n-de-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/adis-b/hackstage",
    "directory": "my-backstage-app/plugins/backstage-i18n-de-plugin"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "configSchema": "config.d.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "i18n:coverage": "node scripts/coverage.cjs",
    "i18n:coverage:check": "node scripts/coverage.cjs --require-coverage 100"
  },
  "dependencies": {
    "@backstage/frontend-plugin-api": "^0.16.0",
    "@backstage/plugin-app-react": "^0.2.0",
    "@backstage/ui": "^0.14.0",
    "@material-ui/icons": "^4.9.1"
  },
  "peerDependencies": {
    "@backstage/core-components": "^0.18.0",
    "@backstage/plugin-api-docs": "^0.14.0",
    "@backstage/plugin-catalog": "^2.0.0",
    "@backstage/plugin-catalog-graph": "^0.6.0",
    "@backstage/plugin-catalog-import": "^0.13.0",
    "@backstage/plugin-catalog-react": "^2.0.0",
    "@backstage/plugin-org": "^0.7.0",
    "@backstage/plugin-scaffolder": "^1.30.0",
    "@backstage/plugin-scaffolder-react": "^1.19.0",
    "@backstage/plugin-search": "^1.7.0",
    "@backstage/plugin-search-react": "^1.9.0",
    "@backstage/plugin-techdocs": "^1.17.0",
    "@backstage/plugin-user-settings": "^0.9.0",
    "react": "^17 || ^18",
    "react-dom": "^17 || ^18"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.1",
    "@backstage/core-components": "^0.18.0",
    "@backstage/frontend-test-utils": "^0.5.0",
    "@backstage/plugin-api-docs": "^0.14.0",
    "@backstage/plugin-catalog": "^2.0.0",
    "@backstage/plugin-catalog-graph": "^0.6.0",
    "@backstage/plugin-catalog-import": "^0.13.0",
    "@backstage/plugin-catalog-react": "^2.0.0",
    "@backstage/plugin-org": "^0.7.0",
    "@backstage/plugin-scaffolder": "^1.30.0",
    "@backstage/plugin-scaffolder-react": "patch:@backstage/plugin-scaffolder-react@npm%3A1.20.1#~/.yarn/patches/@backstage-plugin-scaffolder-react-npm-1.20.1-5db8ed920f.patch",
    "@backstage/plugin-search": "^1.7.0",
    "@backstage/plugin-search-react": "^1.9.0",
    "@backstage/plugin-techdocs": "^1.17.0",
    "@backstage/plugin-user-settings": "^0.9.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0"
  }
}
