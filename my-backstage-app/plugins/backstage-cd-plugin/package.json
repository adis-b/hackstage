{
  "name": "@wien/backstage-cd-plugin",
  "version": "1.0.0",
  "description": "Stadt Wien Corporate Design for Backstage — Wien Rot / Wasserblau themes, Wiener Melange typography, and shared brand tokens.",
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "cd",
    "pluginPackages": [
      "@wien/backstage-cd-plugin"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "theme",
    "stadt-wien",
    "wien",
    "corporate-design"
  ],
  "homepage": "https://github.com/adis-b/hackstage/tree/main/my-backstage-app/plugins/backstage-cd-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/adis-b/hackstage",
    "directory": "my-backstage-app/plugins/backstage-cd-plugin"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "configSchema": "config.d.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/frontend-plugin-api": "^0.16.0",
    "@backstage/plugin-app-react": "^0.2.0",
    "@backstage/theme": "^0.7.0",
    "@material-ui/icons": "^4.9.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "react": "^17 || ^18",
    "react-dom": "^17 || ^18"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.0",
    "@backstage/frontend-test-utils": "^0.5.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0"
  }
}
